{
  "hosting": {
    "public": ".",
    "ignore": ["tools/**", "**/.*", "README.md", "service-worker.js.tmpl"],
    "headers": [
      { "source": "/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/js/version.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
